rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /kyc_documents/{userId}/{allPaths=**} {
      // User can upload their own KYC docs, Admins and owner can read
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'ADMIN');
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 10 * 1024 * 1024;
    }
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
